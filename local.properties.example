# Copy to local.properties (never versioned). Android Studio adds sdk.dir automatically.
sdk.dir=C:\\Android\\Sdk

# Partner platform hosts — provided in the case e-mail, never committed.
# Read by :androidApp into BuildConfig; CI leaves them unset and falls back to a fictitious host,
# tests use Ktor MockEngine and never reach the network.
smarthome.apiHost=https://api.example.invalid
smarthome.portalHost=https://portal.example.invalid

# Live-video kill switch (SPEC V1). Default true. Set to false to run the app on the shared account
# without ever opening a streaming session — the camera screen goes straight to "não anuncia vídeo".
smarthome.liveVideoEnabled=true

# Lock-writes kill switch (SPEC L2, L7). Default true (ADR-028). Set to false to build an app that
# never writes to the lock: the volume selector is disabled and "Habilitar abertura remota" only
# explains what it would do; no write request leaves the app.
smarthome.lockWritesEnabled=true
